# S026: Two exports writing the same file.

concept Student:
  has number: string
  has name: string

query report:
  ?_s a Student
    number ?num
    name ?name
  return
    Number ?num
    ?name

export
  from query report
  to:
    <export://report.csv> as CSV

export
  from query report
  to:
    <export://report.csv> as CSV
