# S020: A `count` that sees a pet once per weight row: no N3 encoding, the rule runs as SHACL-AF only.

concept Owner:
  has pet_count: int
concept BusyOwner:
  sub Owner
concept Pet:
  has owner: Owner
  has weight: float

rule busy_owner:
  match:
    ?owner a Owner
    count ?pet as ?n
      ?pet owner ?owner
      ?pet weight ?w
  then:
    ?owner a BusyOwner
