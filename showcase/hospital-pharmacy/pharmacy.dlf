# Hôpital Saint-Roch (fictional): the hospital pharmacy dispenses drugs to
# the wards. A physician prescribes a drug, a dose per administration, a
# frequency, a route, a start date and a duration; the pharmacist checks it
# and dispenses it from a batch. Every person, value and lot is invented.
#
# Facts are dated against now = 2026-06-15T12:00:00Z (validate/now); ages hold until 2030.

concept Ward:
  has key code: string

  # Age from which a patient of this ward is dosed as an adult.
  has adult_age: one duration

  one of:
    PEDIATRICS [code "PED", adult_age duration(18y)]
    CARDIOLOGY [code "CARD", adult_age duration(18y)]
    ONCOLOGY [code "ONCO", adult_age duration(18y)]
    ER [code "ER", adult_age duration(18y)]

concept DosageForm:
  one of:
    Tablet
    Capsule
    Injection

concept Route:
  one of:
    ORAL
    IV
    IM
    SC

concept Physician:
  has key rpps: string
  has firstName: one string

concept Patient:
  has key mrn: string
  has firstName: one string
  has birthdate: one date
  has age: duration [ = now() - $birthdate ]
  has weight: one mass
  has ward: one Ward

# A child: inferred from the derived age, never asserted. Written as
# `[ some age [ < duration(18y) ] ]` it never matches (rust/BUGS.md): a
# derived field is only computed as `$age`, so the bound sits on the ward.
concept PediatricPatient:
  equivalent to Patient
    [ ward [ adult_age [ > $age ] ] ]

concept Drug:
  has key atc: string
  has name: one string
  has max_single_dose: one mass

  # In mg per kg of body weight. dolfin-units has no mass-per-mass dimension
  # (it would be dimensionless), so this is a plain number.
  has pediatric_max_per_kg: optional float
  has form: one DosageForm

  # Of the ready-to-use solution, for injectables.
  has concentration: optional density

concept Batch:
  has key lot: string
  has drug: one Drug
  has expiry: one date

  # Active substance on hand. No `[ >= 0 ]` here: a bound on a quantity
  # field rejects every value (rust/BUGS.md); the pack count carries it.
  has quantity_on_hand: one mass
  has packs_on_hand: one int [ >= 0 ]

concept Prescription:
  has key rxId: string
  has patient: one Patient
  has prescriber: one Physician
  has drug: one Drug
  has dose: one mass
  has frequency_per_day: one int [ >= 1, <= 24 ]
  has start: one date
  has length: one duration
  has route: one Route

  # Volume to infuse, for IV prescriptions.
  has volume: optional volume

# A prescription sent to the pharmacy for dispensing: the dose may not exceed
# the drug's maximum single dose. The facts below are the ward's record,
# mistakes included (the rules flag them); new data asserts this concept.
concept SafePrescription:
  sub Prescription

  check
    [ $ dose ?d, drug [ max_single_dose [ >= ?d ] ] ]

concept Dispensing:
  has key dispensingId: string
  has prescription: one Prescription
  has batch: one Batch
  has at: one date_time

  # The day of `at`: a date never compares with a date_time (rust/BUGS.md).
  has day: one date

# A dispensing about to be done: the batch must not be expired on that day.
concept SafeDispensing:
  sub Dispensing

  check
    [ $ day ?d, batch [ expiry [ >= ?d ] ] ]

# Inferred by the rules below.
concept OverdoseAlert

concept ExpiredDispensing

concept NeedsPharmacistReview

# A dose above the drug's maximum single dose. Unit-aware: 1500 mg > 1 g.
rule flag_overdose:
  match:
    ?rx dose ?d
    ?rx drug [ max_single_dose [ < ?d ] ]
  then:
    ?rx a OverdoseAlert

# A batch dispensed after its expiry date.
rule flag_expired_dispensing:
  match:
    ?disp day ?d
    ?disp batch [ expiry [ < ?d ] ]
  then:
    ?disp a ExpiredDispensing

# A child prescribed a drug with no pediatric dosing (mg/kg) on file.
rule flag_unchecked_pediatric:
  match:
    ?rx patient [ a PediatricPatient ]
    ?rx drug ?drug
    none ?perKg:
      ?drug pediatric_max_per_kg ?perKg
  then:
    ?rx a NeedsPharmacistReview

