# Sample catalogue. Every organization, brand and product here is fictional.
# Terms are qualified with `schema.` so they resolve to https://schema.org/.

fact atelier a schema.Organization
  schema.name "Atelier Nautile"
  schema.legalName "Atelier Nautile SAS"
  schema.address [
    schema.addressLocality "Nantes"
    schema.addressCountry "FR"
  ]

fact hygge a schema.Organization
  schema.name "Hygge Supply"
  schema.legalName "Hygge Supply ApS"
  schema.address [
    schema.addressLocality "Aarhus"
    schema.addressCountry "DK"
  ]

fact rivabike a schema.Organization
  schema.name "Riva Bikes"
  schema.legalName "Riva Bikes S.r.l."
  schema.address [
    schema.addressLocality "Bergamo"
    schema.addressCountry "IT"
  ]

fact nautile a schema.Brand
  schema.name "Nautile"

fact fjeld a schema.Brand
  schema.name "Fjeld"

fact riva a schema.Brand
  schema.name "Riva"

fact terra a schema.Brand
  schema.name "Terra Kitchen"

fact lamp a schema.Product
  schema.name "Nautile desk lamp"
  schema.sku "NAU-LAMP-01"
  schema.gtin13 "3760123450011"
  schema.brand nautile
  schema.manufacturer atelier
  schema.category "Home > Lighting"
  schema.color "Brass"
  schema.material "Brass"
  schema.weight quantity(1.2 kg)
  schema.offers [
    schema.price 89.0
    schema.priceCurrency "EUR"
    schema.availability schema.InStock
    schema.itemCondition schema.NewCondition
    schema.seller atelier
  ]
  schema.offers [
    schema.price 59.0
    schema.priceCurrency "EUR"
    schema.availability schema.InStock
    schema.itemCondition schema.RefurbishedCondition
    schema.seller atelier
  ]
  schema.aggregateRating [
    schema.ratingValue 4.6
    schema.reviewCount 128
    schema.bestRating 5.0
  ]
  schema.isSimilarTo floorlamp

