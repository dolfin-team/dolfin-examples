@prefix dq: <https://dolfin.dev/quantity#> .
<https://www.dolfin.fr/showcase/city-transit/network> rdf:type owl:Ontology
  ; rdfs:comment "Réseau Lumière (fictional), infrastructure side: the stops of a mid-size French city's tram and bus network, its five lines with their ordered stops, walking connections between stops and step-free access. Imported by the timetable package."
  ; dc:creator "Dolfin"
  ; owl:versionInfo "2.1.0" .

<https://www.dolfin.fr/showcase/city-transit/network/network> rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network> .

network:Length rdf:type rdfs:Class
  ; skos:prefLabel "Length"
  ; rdfs:label "Length"
  ; rdfs:comment "A physical dimension (dolfin-units): a line length in km or m is dimension-checked."
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:FareZone rdf:type rdfs:Class
  ; skos:prefLabel "FareZone"
  ; rdfs:label "FareZone"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:FareZone owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf ( network:FareZone_Z1 network:FareZone_Z2 network:FareZone_Z3 ) ] .

network:FareZone_Z1 rdf:type owl:NamedIndividual , network:FareZone
  ; skos:prefLabel "Z1"
  ; rdfs:label "Z1"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network> .
network:FareZone_Z2 rdf:type owl:NamedIndividual , network:FareZone
  ; skos:prefLabel "Z2"
  ; rdfs:label "Z2"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network> .
network:FareZone_Z3 rdf:type owl:NamedIndividual , network:FareZone
  ; skos:prefLabel "Z3"
  ; rdfs:label "Z3"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network> .

network:Mode rdf:type rdfs:Class
  ; skos:prefLabel "Mode"
  ; rdfs:label "Mode"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:Mode owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf ( network:Mode_TRAM network:Mode_BUS network:Mode_BRT ) ] .

network:Mode_TRAM rdf:type owl:NamedIndividual , network:Mode
  ; skos:prefLabel "Tram"
  ; rdfs:label "Tram"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network> .
network:Mode_BUS rdf:type owl:NamedIndividual , network:Mode
  ; skos:prefLabel "Bus"
  ; rdfs:label "Bus"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network> .
network:Mode_BRT rdf:type owl:NamedIndividual , network:Mode
  ; skos:prefLabel "Brt"
  ; rdfs:label "Brt"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network> .

network:Stop rdf:type rdfs:Class
  ; owl:hasKey ( network:stop_code )
  ; skos:prefLabel "Stop"
  ; rdfs:label "Stop"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:stop_code rdf:type owl:DatatypeProperty
  ; rdfs:domain network:Stop
  ; rdfs:range xsd:string
  ; skos:prefLabel "stop_code"
  ; rdfs:label "stop_code"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:name rdf:type owl:DatatypeProperty
  ; rdfs:domain network:Stop
  ; rdfs:range xsd:string
  ; rdf:type owl:FunctionalProperty
  ; skos:prefLabel "name"
  ; rdfs:label "name"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .
network:Stop owl:equivalentClass [
  rdf:type owl:Restriction
  ; owl:onProperty network:name ;
  owl:cardinality "1"^^xsd:nonNegativeInteger
  ]
  .

network:lat rdf:type owl:DatatypeProperty
  ; rdfs:domain network:Stop
  ; rdfs:range xsd:double
  ; rdf:type owl:FunctionalProperty
  ; skos:prefLabel "lat"
  ; rdfs:label "lat"
  ; rdfs:comment "WGS 84, in degrees."
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .
network:Stop owl:equivalentClass [
  rdf:type owl:Restriction
  ; owl:onProperty network:lat ;
  owl:cardinality "1"^^xsd:nonNegativeInteger
  ]
  .

network:long rdf:type owl:DatatypeProperty
  ; rdfs:domain network:Stop
  ; rdfs:range xsd:double
  ; rdf:type owl:FunctionalProperty
  ; skos:prefLabel "long"
  ; rdfs:label "long"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .
network:Stop owl:equivalentClass [
  rdf:type owl:Restriction
  ; owl:onProperty network:long ;
  owl:cardinality "1"^^xsd:nonNegativeInteger
  ]
  .

network:accessible rdf:type owl:DatatypeProperty
  ; rdfs:domain network:Stop
  ; rdfs:range xsd:boolean
  ; rdf:type owl:FunctionalProperty
  ; skos:prefLabel "accessible"
  ; rdfs:label "accessible"
  ; rdfs:comment "Step-free from the street to a low-floor vehicle."
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .
network:Stop owl:equivalentClass [
  rdf:type owl:Restriction
  ; owl:onProperty network:accessible ;
  owl:cardinality "1"^^xsd:nonNegativeInteger
  ]
  .

network:zone rdf:type owl:ObjectProperty
  ; rdfs:domain network:Stop
  ; rdfs:range network:FareZone
  ; rdf:type owl:FunctionalProperty
  ; skos:prefLabel "zone"
  ; rdfs:label "zone"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .
network:Stop owl:equivalentClass [
  rdf:type owl:Restriction
  ; owl:onProperty network:zone ;
  owl:cardinality "1"^^xsd:nonNegativeInteger
  ]
  .

network:Line rdf:type rdfs:Class
  ; owl:hasKey ( network:code )
  ; skos:prefLabel "Line"
  ; rdfs:label "Line"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:code rdf:type owl:DatatypeProperty
  ; rdfs:domain network:Line
  ; rdfs:range xsd:string
  ; skos:prefLabel "code"
  ; rdfs:label "code"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:mode rdf:type owl:ObjectProperty
  ; rdfs:domain network:Line
  ; rdfs:range network:Mode
  ; rdf:type owl:FunctionalProperty
  ; skos:prefLabel "mode"
  ; rdfs:label "mode"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .
network:Line owl:equivalentClass [
  rdf:type owl:Restriction
  ; owl:onProperty network:mode ;
  owl:cardinality "1"^^xsd:nonNegativeInteger
  ]
  .

network:stops rdf:type owl:ObjectProperty
  ; rdfs:domain network:Line
  ; rdfs:range rdf:List
  ; rdf:type owl:FunctionalProperty
  ; skos:prefLabel "stops"
  ; rdfs:label "stops"
  ; rdfs:comment "The stops in running order, from one terminus to the other. Not filled in the facts: a `list of` value in a fact is emitted as one plain triple per stop, not as an rdf:List, and then fails sh:maxCount 1 (rust/BUGS.md, mountain-ultra A). `serves` lists the stops in running order instead."
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:length rdf:type owl:DatatypeProperty
  ; rdfs:domain network:Line
  ; rdfs:range <http://qudt.org/vocab/quantitykind/Length>
  ; rdf:type owl:FunctionalProperty
  ; skos:prefLabel "length"
  ; rdfs:label "length"
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .
network:Line owl:equivalentClass [
  rdf:type owl:Restriction
  ; owl:onProperty network:length ;
  owl:cardinality "1"^^xsd:nonNegativeInteger
  ]
  .

network:serves rdf:type owl:ObjectProperty
  ; rdfs:domain network:Line
  ; rdfs:range network:Stop
  ; skos:prefLabel "serves"
  ; rdfs:label "serves"
  ; rdfs:comment "The stops a line calls at, without order: what other packages query and check against. Written next to `stops` in every line below."
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:served_by rdf:type owl:ObjectProperty
  ; rdfs:domain network:Stop
  ; rdfs:range network:Line
  ; skos:prefLabel "served_by"
  ; rdfs:label "served_by"
  ; owl:inverseOf network:serves
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:connected_to rdf:type owl:ObjectProperty
  ; rdfs:domain network:Stop
  ; rdfs:range network:Stop
  ; skos:prefLabel "connected_to"
  ; rdfs:label "connected_to"
  ; rdfs:comment "A walkway between two nearby stops of different lines: both directions."
  ; rdf:type owl:SymmetricProperty
  ; rdfs:subPropertyOf network:reachable_from
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:reachable_from rdf:type owl:ObjectProperty
  ; rdfs:domain network:Stop
  ; rdfs:range network:Stop
  ; skos:prefLabel "reachable_from"
  ; rdfs:label "reachable_from"
  ; rdfs:comment "On foot through one or more walkways."
  ; rdf:type owl:TransitiveProperty
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .

network:GAR rdf:type owl:NamedIndividual
  , network:Stop
  ; rdfs:comment "Stops. Walkways (`connected_to`) are written once, on one end: `symmetric` gives the other direction. Pont des Arts – Musée des Tisserands – Opéra – Hôtel de Ville form a chain, so under OWL reasoning (`transitive`) Pont des Arts is reachable from Hôtel de Ville; Bibliothèque – Marché Couvert links T1 and T3."
  ; rdfs:isDefinedBy <https://www.dolfin.fr/showcase/city-transit/network/network>
  .
network:GAR network:stop_code "GAR" .
network:GAR network:name "Gare Centrale" .
network:GAR network:lat "45.7598"^^xsd:float .
network:GAR network:long "4.8261"^^xsd:float .
network:GAR network:accessible "true"^^xsd:boolean .
network:GAR network:zone network:FareZone_Z1 .

