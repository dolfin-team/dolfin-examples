# A T1 journey timed at Hôtel de Ville, which T1 does not serve (net:serves, from the network package).
@prefix tt: <https://www.dolfin.fr/showcase/city-transit/timetable/timetable#> .
@prefix net: <https://www.dolfin.fr/showcase/city-transit/network/network#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tt:SJ-T1-91 a tt:ServiceJourney ; tt:journey_id "SJ-T1-91" ; tt:line net:T1 ; tt:vehicle tt:VehicleType_CITADIS_402 ; tt:day_type tt:DayType_WEEKDAY ;
  tt:passing_times tt:SJ-T1-91-1, tt:SJ-T1-91-2 .
tt:SJ-T1-91-1 a tt:PassingTime ; tt:journey tt:SJ-T1-91 ; tt:stop net:GAR ; tt:departure "21:10:00"^^xsd:time .
tt:SJ-T1-91-2 a tt:PassingTime ; tt:journey tt:SJ-T1-91 ; tt:stop net:HDV ; tt:departure "21:16:00"^^xsd:time .
