# Réseau Lumière (fictional): the tram and bus network of a mid-size French
# city. This package is the infrastructure team's: stops, lines, the order of
# the stops on each line, walking connections and step-free access. The
# operations team's timetable package imports it at a pinned version.
# Every name, code and coordinate is invented.

concept FareZone:
  one of:
    Z1
    Z2
    Z3

concept Mode:
  one of:
    TRAM
    BUS
    BRT

concept Stop:
  has key stop_code: string
  has name: one string

  # WGS 84, in degrees.
  has lat: one float [ >= -90, <= 90 ]
  has long: one float [ >= -180, <= 180 ]

  # Step-free from the street to a low-floor vehicle.
  has accessible: one boolean
  has zone: one FareZone

concept Line:
  has key code: string
  has mode: one Mode

  # The stops in running order, from one terminus to the other. Not filled
  # in the facts: a `list of` value in a fact is emitted as one plain triple
  # per stop, not as an rdf:List, and then fails sh:maxCount 1 (rust/BUGS.md,
  # mountain-ultra A). `serves` lists the stops in running order instead.
  has stops: list of Stop
  has length: one length

# The stops a line calls at, without order: what other packages query and
# check against. Written next to `stops` in every line below.
property serves: Line -> Stop

property served_by: Stop -> Line
  inverse of serves

# A walkway between two nearby stops of different lines: both directions.
property connected_to: Stop -> Stop
  symmetric
  sub reachable_from

# On foot through one or more walkways.
property reachable_from: Stop -> Stop
  transitive

# Stops. Walkways (`connected_to`) are written once, on one end: `symmetric`
# gives the other direction. Pont des Arts – Musée des Tisserands – Opéra –
# Hôtel de Ville form a chain, so under OWL reasoning (`transitive`) Pont des
# Arts is reachable from Hôtel de Ville; Bibliothèque – Marché Couvert links
# T1 and T3.

fact GAR a Stop
  stop_code "GAR"
  name "Gare Centrale"
  lat 45.7598
  long 4.8261
  accessible true
  zone Z1

fact REP a Stop
  stop_code "REP"
  name "République"
  lat 45.7631
  long 4.8352
  accessible true
  zone Z1

fact HDV a Stop
  stop_code "HDV"
  name "Hôtel de Ville"
  lat 45.7672
  long 4.8336
  accessible true
  zone Z1

fact OPE a Stop
  stop_code "OPE"
  name "Opéra"
  lat 45.7679
  long 4.8364
  accessible false
  zone Z1
  connected_to HDV

fact MAR a Stop
  stop_code "MAR"
  name "Marché Couvert"
  lat 45.7705
  long 4.841
  accessible true
  zone Z1

fact PON a Stop
  stop_code "PON"
  name "Pont des Arts"
  lat 45.7611
  long 4.8203
  accessible true
  zone Z1
