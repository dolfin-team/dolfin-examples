# Lines. T1 runs Gare Centrale – Technopôle through the university, T2 Port
# Fluvial – Plaine des Sports (the north–south spine), T3 Musée des
# Tisserands – Cimetière Est, bus 10 Gare Centrale up the hill to Vergers,
# bus 11 Université – Moulin Neuf (the outer ring). Interchanges, stops on
# two lines or more: GAR (T1, T2, B10), HDV (T2, T3, B11), REP (T1, T3) and
# UNI (T1, B11).

fact T1 a Line
  code "T1"
  mode TRAM
  serves GAR, REP, BIB, UNI, HOP, TEC
  length quantity(9.4 km)

fact T2 a Line
  code "T2"
  mode TRAM
  serves POR, PON, GAR, HDV, CAS, STA, PLA
  length quantity(8.1 km)

fact T3 a Line
  code "T3"
  mode TRAM
  serves MUS, REP, HDV, MAR, CHA, CIM
  length quantity(6.3 km)

fact B10 a Line
  code "B10"
  mode BUS
  serves GAR, OPE, COL, BEL, VER
  length quantity(5.2 km)

fact B11 a Line
  code "B11"
  mode BUS
  serves UNI, LYC, PAR, HDV, ZAC, AER, MOU
  length quantity(11.7 km)
