fact jord a Deity
  name "Jörð"
  tradition norse
  domain Earth
  summary "Personified Earth, mother of Thor."
  parentOf thor

fact thor a Deity
  name "Thor"
  tradition norse
  domain Thunder, Storm
  alsoKnownAs "Donar"
  alsoKnownAs "Thunor"
  summary "Protector of gods and humans."
  spouseOf sif
  dwellsIn asgard

fact sif a Deity
  name "Sif"
  tradition norse
  domain Harvest
  summary "Golden-haired wife of Thor."
  dwellsIn asgard

fact baldr a Deity
  name "Baldr"
  tradition norse
  domain Sun
  summary "Shining god whose death foreshadows Ragnarök."
  dwellsIn asgard

fact loki a Deity
  name "Loki"
  tradition norse
  domain Trickery, Fire
  summary "Shape-shifting trickster."
  dwellsIn asgard
  parentOf fenrir, jormungandr, hel

fact angrboda a Deity
  name "Angrboða"
  tradition norse
  summary "Giantess, mother of Loki's monstrous children."
  parentOf fenrir, jormungandr, hel

fact fenrir a Creature
  name "Fenrir"
  tradition norse
  domain Destruction
  summary "Giant wolf bound by the gods."

fact jormungandr a Creature
  name "Jörmungandr"
  tradition norse
  domain Sea
  alsoKnownAs "Midgard Serpent"
  summary "Serpent encircling the world."

fact hel a Deity
  name "Hel"
  tradition norse
  domain Death, Underworld
  summary "Ruler of the realm of the dead."
  dwellsIn helheim

fact njord a Deity
  name "Njörðr"
  tradition norse
  domain Sea, Prosperity
  summary "Vanir god of the sea and wealth."
