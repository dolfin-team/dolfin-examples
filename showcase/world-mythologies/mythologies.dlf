# World mythologies and traditions — one shared model, one section per tradition.
#
# Several of these traditions are living religions (Hindu, Shinto, Maya
# spirituality, modern Heathenry and Hellenism). Entries are descriptive and
# follow the classic written sources named on each Tradition.

concept Tradition:
  has key name: string
  has region: one string
  has mainSources: some string

concept Domain:
  one of:
    Sky
    Thunder
    Storm
    Rain
    Sea
    Sun
    Moon
    Earth
    Harvest
    Prosperity
    War
    Wisdom
    Love
    Death
    Underworld
    Creation
    Destruction
    Preservation
    Fire
    Trickery
    Craft
    Hunt
    Healing
    Hearth

concept Figure:
  has key name: string
  has tradition: one Tradition
  has domain: Domain
  has alsoKnownAs: string
  has summary: optional string

concept Deity:
  sub Figure

concept Hero:
  sub Figure

concept Creature:
  sub Figure

concept Realm:
  has key name: string
  has tradition: one Tradition

concept Artifact:
  has key name: string
  has wieldedBy: one Figure

property parentOf: Figure -> Figure
property spouseOf: Figure -> Figure
property avatarOf: Figure -> Figure
property dwellsIn: Figure -> Realm
property ancestorOf: Figure -> Figure

# Genealogy is transitive: a parent's ancestors are ancestors too.
rule parent_is_ancestor:
  match:
    ?a parentOf ?b
  then:
    ?a ancestorOf ?b

rule ancestor_chain:
  match:
    ?a ancestorOf ?b
    ?b ancestorOf ?c
  then:
    ?a ancestorOf ?c


# ── Greek ───────────────────────────────────────────────────────

fact greek a Tradition
  name "Greek"
  region "Ancient Greece"
  mainSources "Hesiod, Theogony", "Homer, Iliad and Odyssey"

fact olympus a Realm
  name "Mount Olympus"
  tradition greek

fact greek_underworld a Realm
  name "The Underworld"
  tradition greek

fact gaia a Deity
  name "Gaia"
  tradition greek
  domain Earth, Creation
  summary "Primordial Earth, mother of the Titans."
  parentOf uranus, cronus, rhea

fact uranus a Deity
  name "Uranus"
  tradition greek
  domain Sky
  summary "Primordial Sky."
  spouseOf gaia
  parentOf cronus, rhea, aphrodite

fact cronus a Deity
  name "Cronus"
  tradition greek
  domain Harvest
  alsoKnownAs "Saturn"
  summary "Titan who ruled before Zeus."
  spouseOf rhea
  parentOf zeus, hera, poseidon, hades, demeter, hestia

fact rhea a Deity
  name "Rhea"
  tradition greek
  domain Earth
  summary "Titaness, mother of the Olympian elders."
  parentOf zeus, hera, poseidon, hades, demeter, hestia

fact zeus a Deity
  name "Zeus"
  tradition greek
  domain Sky, Thunder
  alsoKnownAs "Jupiter"
  summary "King of the Olympian gods."
  spouseOf hera
  dwellsIn olympus
  parentOf persephone, athena, apollo, artemis, ares, hermes, heracles, perseus

fact hera a Deity
  name "Hera"
  tradition greek
  domain Love
  alsoKnownAs "Juno"
  summary "Queen of the gods, goddess of marriage."
  dwellsIn olympus
  parentOf ares, hephaestus

fact poseidon a Deity
  name "Poseidon"
  tradition greek
  domain Sea, Storm
  alsoKnownAs "Neptune"
  summary "God of the sea and earthquakes."

fact hades a Deity
  name "Hades"
  tradition greek
  domain Death, Underworld
  alsoKnownAs "Pluto"
  summary "Ruler of the underworld."
  spouseOf persephone
  dwellsIn greek_underworld

fact demeter a Deity
  name "Demeter"
  tradition greek
  domain Harvest
  alsoKnownAs "Ceres"
  summary "Goddess of grain and agriculture."
  dwellsIn olympus
  parentOf persephone

fact hestia a Deity
  name "Hestia"
  tradition greek
  domain Hearth
  alsoKnownAs "Vesta"
  summary "Goddess of the hearth."
  dwellsIn olympus

fact persephone a Deity
  name "Persephone"
  tradition greek
  domain Harvest, Underworld
  alsoKnownAs "Proserpina"
  summary "Queen of the underworld; her return brings spring."
  dwellsIn greek_underworld

fact athena a Deity
  name "Athena"
  tradition greek
  domain Wisdom, War, Craft
  alsoKnownAs "Minerva"
  summary "Goddess of wisdom and strategy."
  dwellsIn olympus

fact leto a Deity
  name "Leto"
  tradition greek
  alsoKnownAs "Latona"
  summary "Titaness, mother of Apollo and Artemis."
  parentOf apollo, artemis

fact apollo a Deity
  name "Apollo"
  tradition greek
  domain Sun, Healing
  summary "God of light, music, prophecy and healing."
  dwellsIn olympus

fact artemis a Deity
  name "Artemis"
  tradition greek
  domain Moon, Hunt
  alsoKnownAs "Diana"
  summary "Goddess of the hunt and the wild."
  dwellsIn olympus

fact ares a Deity
  name "Ares"
  tradition greek
  domain War
  alsoKnownAs "Mars"
  summary "God of war."
  dwellsIn olympus

fact hephaestus a Deity
  name "Hephaestus"
  tradition greek
  domain Fire, Craft
  alsoKnownAs "Vulcan"
  summary "Smith of the gods."
  spouseOf aphrodite
  dwellsIn olympus

fact aphrodite a Deity
  name "Aphrodite"
  tradition greek
  domain Love
  alsoKnownAs "Venus"
  summary "Goddess of love and beauty."
  dwellsIn olympus

fact hermes a Deity
  name "Hermes"
  tradition greek
  domain Trickery
  alsoKnownAs "Mercury"
  summary "Messenger of the gods, guide of souls."
  dwellsIn olympus

fact heracles a Hero
  name "Heracles"
  tradition greek
  alsoKnownAs "Hercules"
  summary "Hero of the Twelve Labours."

fact perseus a Hero
  name "Perseus"
  tradition greek
  summary "Slayer of Medusa."

fact medusa a Creature
  name "Medusa"
  tradition greek
  summary "Gorgon whose gaze turned onlookers to stone."

fact cerberus a Creature
  name "Cerberus"
  tradition greek
  domain Underworld
  summary "Many-headed hound guarding the underworld."
  dwellsIn greek_underworld

fact thunderbolt a Artifact
  name "Thunderbolt of Zeus"
  wieldedBy zeus

fact trident a Artifact
  name "Trident of Poseidon"
  wieldedBy poseidon


# ── Norse ───────────────────────────────────────────────────────

fact norse a Tradition
  name "Norse"
  region "Scandinavia and Iceland"
  mainSources "Snorri Sturluson, Prose Edda", "Poetic Edda"

fact asgard a Realm
  name "Asgard"
  tradition norse

fact helheim a Realm
  name "Helheim"
  tradition norse

fact ymir a Creature
  name "Ymir"
  tradition norse
  domain Creation
  summary "Primordial giant from whose body the world was made."

fact buri a Deity
  name "Búri"
  tradition norse
  summary "First of the gods, freed from the ice by the cow Auðumbla."
  parentOf borr

fact borr a Deity
  name "Borr"
  tradition norse
  summary "Son of Búri, father of Odin."
  spouseOf bestla
  parentOf odin

fact bestla a Deity
  name "Bestla"
  tradition norse
  summary "Giantess, mother of Odin."
