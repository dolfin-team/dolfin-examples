# Digital battery passport — the data a manufacturer must publish for every
# EV, industrial (> 2 kWh) and light-means-of-transport battery placed on the
# EU market from February 2027 (Regulation (EU) 2023/1542, Art. 77, Annex XIII).

concept BatteryCategory:
  one of:
    ElectricVehicle
    Industrial
    LightMeansOfTransport

concept Chemistry:
  has key code: string

  one of:
    NMC [code "NMC"]
    NCA [code "NCA"]
    LFP [code "LFP"]
    SodiumIon [code "Na-ion"]

concept Country:
  has key isoCode: string
  has name: one string

concept Manufacturer:
  has key name: string
  has country: one Country

concept ManufacturingPlant:
  has key name: string
  has operatedBy: one Manufacturer
  has country: one Country

# Share of a critical raw material recovered from recycling (Art. 8).
concept RecycledContent:
  has material: one CriticalMaterial
  has sharePercent: one float

concept CriticalMaterial:
  one of:
    Cobalt
    Lithium
    Nickel
    Lead

# Carbon footprint over the life cycle, excluding use phase (Art. 7).
concept CarbonFootprint:
  has total: one mass
  has perKWh: one float
  has performanceClass: one FootprintClass

concept FootprintClass:
  one of:
    ClassA
    ClassB
    ClassC
    ClassD
    ClassE

concept BatteryModel:
  has key modelId: string
  has category: one BatteryCategory
  has chemistry: one Chemistry
  has manufacturer: one Manufacturer
  has ratedEnergy: one energy
  has peakPower: optional power
  has mass: one mass
  has nominalVoltageV: one float
  has expectedCycleLife: one int
  has carbonFootprint: one CarbonFootprint
  has recycledContent: RecycledContent
  has containsHazardousSubstance: string

# One physical battery, identified by its unique passport ID (QR code).
concept Battery:
  has key passportId: string
  has model: one BatteryModel
  has plant: one ManufacturingPlant
  has manufacturedOn: one date
  has stateOfHealthPercent: optional float
  has status: one BatteryStatus

concept BatteryStatus:
  one of:
    Original
    Repurposed
    Remanufactured
    Waste

# Flags computed by the rules below.
concept SecondLifeCandidate
concept LowCarbonModel

# A used EV battery still above 70 % state of health is worth repurposing
# (e.g. as stationary storage) rather than recycling.
rule second_life_candidate:
  match:
    ?b a Battery
    ?b model [ category ElectricVehicle ]
    ?b status Original
    ?b stateOfHealthPercent [ >= 70.0, < 85.0 ]
  then:
    ?b a SecondLifeCandidate

rule low_carbon_model:
  match:
    ?m a BatteryModel
    ?m carbonFootprint [ perKWh [ <= 60.0 ] ]
  then:
    ?m a LowCarbonModel

# Sample data. Every manufacturer, plant and battery below is fictional.

fact country_FR a Country
  isoCode "FR"
  name "France"

fact country_DE a Country
  isoCode "DE"
  name "Germany"

fact country_PL a Country
  isoCode "PL"
  name "Poland"

fact country_SE a Country
  isoCode "SE"
  name "Sweden"

fact country_HU a Country
  isoCode "HU"
  name "Hungary"

fact country_CN a Country
  isoCode "CN"
  name "China"

fact voltara a Manufacturer
  name "Voltara Cells"
  country country_FR

fact nordcell a Manufacturer
  name "Nordcell AB"
  country country_SE

fact kraftwerk a Manufacturer
  name "Kraftzelle GmbH"
  country country_DE

fact lumen a Manufacturer
  name "Lumen Energy Co."
  country country_CN

fact plant_dunkirk a ManufacturingPlant
  name "Voltara Dunkirk Gigafactory"
  operatedBy voltara
  country country_FR

fact plant_skelleftea a ManufacturingPlant
  name "Nordcell North"
  operatedBy nordcell
  country country_SE

fact plant_wroclaw a ManufacturingPlant
  name "Kraftzelle Wrocław"
  operatedBy kraftwerk
  country country_PL

fact plant_debrecen a ManufacturingPlant
  name "Lumen Debrecen"
  operatedBy lumen
  country country_HU

fact plant_ningde a ManufacturingPlant
  name "Lumen Ningde"
  operatedBy lumen
  country country_CN

fact model_vc_ev75 a BatteryModel
  modelId "VC-EV75"
  category ElectricVehicle
  chemistry NMC
  manufacturer voltara
  ratedEnergy quantity(75 kW.h)
  peakPower quantity(210 kW)
  mass quantity(480 kg)
  nominalVoltageV 400.0
  expectedCycleLife 1800
  carbonFootprint [
    total quantity(4350 kg)
    perKWh 58.0
    performanceClass ClassA
  ]
  recycledContent [
    material Cobalt
    sharePercent 18.0
  ]
  recycledContent [
