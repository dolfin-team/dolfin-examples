# Soleil du Diois (fictional): a citizen solar energy community in a Drôme
# valley. Its sites share the output of rooftop PV on two low-voltage feeders;
# each site's smart meter reports, every day, the energy it imported and
# exported and the highest power it drew (readings.dlf).

concept SiteKind:
  one of:
    HOUSEHOLD
    SCHOOL
    DAIRY

concept Feeder:
  has key code: string
  has max_injection: power

  one of:
    DEPART_A [code "DEPART_A", max_injection quantity(60 kW)]
    DEPART_B [code "DEPART_B", max_injection quantity(60 kW)]

concept Site:
  # A 14-digit delivery point number, as Enedis PDLs (invented).
  has key pdl: string
  has name: one string
  has kind: one SiteKind
  has feeder: one Feeder

  # Enedis contracts are in kVA (apparent power). No `VA` unit is built in,
  # and a comparison with a `unitdef kVA` unit compiles to a string compare
  # (rust/BUGS.md, seed-cooperative D), so contracts are in kW: at a power
  # factor of 1, 6 kVA draws 6 kW.
  has contracted_power: one power

concept Installation:
  has site: one Site
  has peak_power: one power
  has commissioned: one date

concept DailyReading:
  key:
    has site: Site
    has day: date

  has working_day: one boolean
  # Not negative: see InvalidReading below.
  has imported: one energy
  has exported: one energy
  has peak_draw: one power

# What the rules below conclude. Plain concepts, not `sub Site`: a `Site`
# subclass derived by a rule puts the `pdl` key rule in a later stratum,
# which SHACL refuses (rust/BUGS.md, high-school).
concept Producer

concept OverContract

concept CrowdedFeeder

concept IdleInstallation

concept SchoolOnHoliday

# A reading the hub rejects: a negative energy. It cannot stand without the
# operator's correction note. (A `[ >= 0 ]` bound on a quantity field rejects
# every value, and a quantity `check` never fails: rust/BUGS.md,
# hospital-pharmacy A and B. A rule compares quantities by magnitude.)
concept InvalidReading:
  has correction: one string

# The month's imported energy of a site, computed by `monthly_import_total`.
# A property, not a `has … energy`: a sum over mixed units is in the SI unit
# kg.m2.s-2 (J), which has no `dq:` definition, so the energy check would
# reject it (rust/BUGS.md, solar-community B).
property monthly_import: Site -> float

# Stratum 0: a plain rule. Every rule below counts or groups Producers, so it
# runs after this one.
rule producer:
  match:
    ?pv a Installation
    ?pv site ?site
  then:
    ?site a Producer

# The month's import of each site. Sites whose meter reports in one unit keep
# it (a Wh meter sums to Wh); H07, whose meter changed from Wh to kWh on
# 16 July, sums in J.
rule monthly_import_total:
  match:
    ?site a Site
    sum ?e as ?total
      ?r site ?site
      ?r imported ?e
  then:
    ?site monthly_import ?total

# The highest daily peak above the contract. `?peak [ > ?contract ]` never
# fires (rust/BUGS.md, solar-community A), so there is one rule per contract
# level (6, 9 and 36 kVA), with literal thresholds. `>` is strict: H09 peaks at exactly 9 kW
# on its 9 kVA contract and is not over it.
rule over_contract_6kw:
  match:
    ?site contracted_power [ <= quantity(6 kW) ]
    max ?p as ?peak
      ?r site ?site
      ?r peak_draw ?p
    ?peak [ > quantity(6 kW) ]
  then:
    ?site a OverContract

rule over_contract_9kw:
  match:
    ?site contracted_power [ > quantity(6 kW), <= quantity(9 kW) ]
    max ?p as ?peak
      ?r site ?site
      ?r peak_draw ?p
    ?peak [ > quantity(9 kW) ]
  then:
    ?site a OverContract

rule over_contract_36kw:
  match:
    ?site contracted_power [ > quantity(9 kW), <= quantity(36 kW) ]
    max ?p as ?peak
      ?r site ?site
      ?r peak_draw ?p
    ?peak [ > quantity(36 kW) ]
  then:
    ?site a OverContract

# Five producers or more on one feeder: on a sunny noon they all export at
# once. DEPART_A has exactly 5 (>= 5 fires), DEPART_B 2.
rule crowded_feeder:
  match:
    ?f a Feeder
    count distinct ?site as ?n
      ?site a Producer
      ?site feeder ?f
    ?n [ >= 5 ]
  then:
    ?f a CrowdedFeeder

# A producer that exported nothing all month. A `sum` over no readings has no
# value (syntax.md, "Aggregates in rules"), so the rule counts the readings
# with an export instead: a count over an empty group is 0. Fires for H10
# (inverter down, every export 0) and H11 (no reading at all yet).
rule idle_installation:
  match:
    ?site a Producer
    count ?r as ?n
      ?r site ?site
      ?r exported [ > quantity(0 W.h) ]
    ?n [ = 0 ]
  then:
    ?site a IdleInstallation

# A school whose average weekday import since Monday 6 July is under
# 40 kWh: it is closed. The école (in MWh) closed on 4 July; the day-camp
# (in kWh) is open all summer.
rule low_average_school:
  match:
    ?site kind SCHOOL
    average ?e as ?avg
      ?r site ?site
      ?r working_day true
      ?r day [ >= date(July 6 2026) ]
      ?r imported ?e
    ?avg [ < quantity(40 kW.h) ]
  then:
    ?site a SchoolOnHoliday

rule invalid_reading:
  match:
    ?r imported [ < quantity(0 W.h) ]
  then:
    ?r a InvalidReading

rule invalid_export:
  match:
    ?r exported [ < quantity(0 W.h) ]
  then:
    ?r a InvalidReading

# Stratification demo, not live. Add this rule, which makes every site of a
# crowded feeder a Producer:
#
#   rule crowded_members:
#     match:
#       ?site feeder ?f
#       ?f a CrowdedFeeder
#     then:
#       ?site a Producer
#
# crowded_feeder counts Producers to derive CrowdedFeeder, and
# crowded_members derives Producers from CrowdedFeeder: a cycle through an
# aggregate. `radeau build --emit shacl` (and `--emit n3-rules`) refuses it:
#
#   Error: Code generation error: Unstratifiable negation cycle through: rule crowded_feeder, rule crowded_members
#
# `radeau validate` gives `Error: SHACL emission failed: Unstratifiable
# negation cycle through: rule crowded_feeder, rule crowded_members`.
# `radeau check` exits 0 on it (rust/BUGS.md, solar-community D).

