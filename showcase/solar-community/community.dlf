# Edge case: the inverter has been down all month, every export reading is 0:
# IdleInstallation.
fact pv_h10 a Installation
  site site_26140000000110
  peak_power quantity(3 kW)
  commissioned date(May 12 2023)

# Edge case: commissioned on 20 July, its meter is not on the data hub yet,
# so the site has no reading at all: IdleInstallation too (a count over no
# readings is 0).
fact pv_h11 a Installation
  site site_26140000000111
  peak_power quantity(6 kW)
  commissioned date(July 20 2026)
