# The Ultra des Trois Cols (fictional): the race model, the runners, the
# timing-mat passages, the rules and the checks. The checkpoints are in
# course.dlf. Every runner and time is invented.
#
# This file has no @timezone: the chips record UTC (`UTC` inline), the aid
# station volunteers local time (`+02:00` inline). A date_time compares by
# instant, so 13:30 UTC equals the 15:30 local cutoff.
#
# Facts are dated against now = 2026-07-12T12:00:00Z (validate/now).

concept Checkpoint:
  has key code: string
  has name: one string
  has distance_from_start: one length

  # No `[ >= 0 ]`: a bound on a quantity field rejects every value
  # (rust/BUGS.md, hospital-pharmacy A); see validate/known-bug/.
  has altitude: one length
  has cumulative_gain: one length
  has cutoff: one date_time

  # The course order. `previous` is the inverse, `after` the transitive
  # "comes later on the course" (filled by the rules below).
  has next: optional Checkpoint
    inverse of previous
  has after: Checkpoint
    transitive

concept Course:
  has name: one string

  # Emitted as rdfs:range rdf:List: one list node, the checkpoints in order.
  has checkpoints: list of Checkpoint
  has total_distance: one length

concept GearItem:
  one of:
    HEADLAMP
    SURVIVAL_BLANKET
    WATER_1L
    RAIN_JACKET
    POLES

# Age groups on race day: senior 20-39, master 1 40-49, master 2 50-59.
concept Category:
  has min_age: one duration
  has max_age: one duration

  one of:
    SEN_H [min_age duration(20y), max_age duration(40y)]
    SEN_F [min_age duration(20y), max_age duration(40y)]
    M1_H [min_age duration(40y), max_age duration(50y)]
    M1_F [min_age duration(40y), max_age duration(50y)]
    M2_H [min_age duration(50y), max_age duration(60y)]
    M2_F [min_age duration(50y), max_age duration(60y)]

concept Runner:
  has key bib: int
  has first_name: one string
  has category: one Category
  has gear: set of GearItem
  has birthdate: one date
  has age: duration [ = now() - $birthdate ]

  # Results, precomputed: rules have no arithmetic or aggregates, so the
  # finish time and the speed are facts (the speed by quantity arithmetic).
  has finish_time: optional duration
  has avg_speed: optional speed

  # The same speed as a plain number of km/h: `average` over a quantity
  # field is unbound (rust/BUGS.md, mountain-ultra B).
  has avg_speed_kmh: optional float

  # The category must match the age (written with `$age`: a derived field in
  # the property position reads a stored triple, rust/BUGS.md C).
  check
    [ category [ min_age [ <= $age ], max_age [ > $age ] ] ]

# The three mandatory items, each one an owl:hasValue restriction.
concept FullyEquipped:
  equivalent to Runner
    with gear: = HEADLAMP
    with gear: = SURVIVAL_BLANKET
    with gear: = WATER_1L

# A timing-mat record. Two records for the same runner at the same
# checkpoint are the same passage (owl:hasKey, owl:sameAs).
concept Passage:
  key:
    has runner: Runner
    has checkpoint: Checkpoint
  has at: one date_time

# A passage submitted for the official ranking: not after the cutoff (the
# cutoff is inclusive). The facts are the raw timing log, late passages
# included (the rules flag them); new data asserts this concept.
concept RankedPassage:
  sub Passage

  check
    [ $ at ?t, checkpoint [ cutoff [ >= ?t ] ] ]

# Timed at the finish line. The OWL definition is not materialized by the
# showcase harness (no OWL reasoning), so the rule `finisher` infers it too.
concept Finisher:
  equivalent to Runner
    with ^runner: Passage
      with checkpoint: = finish

# Inferred by the rules below.
concept DNFCutoff

concept GearPenalty

# Strictly after the cutoff: a passage exactly at the cutoff stays in.
rule dnf_cutoff:
  match:
    ?p at ?t
    ?p checkpoint [ cutoff [ < ?t ] ]
    ?p runner ?r
  then:
    ?r a DNFCutoff

rule finisher:
  match:
    ?p checkpoint finish
    ?p runner ?r
  then:
    ?r a Finisher

# Not FullyEquipped: no binding has all three items.
rule missing_gear:
  match:
    ?r a Runner
    none ?r:
      ?r gear HEADLAMP
      ?r gear SURVIVAL_BLANKET
      ?r gear WATER_1L
  then:
    ?r a GearPenalty

# `transitive` is an OWL characteristic; retox does no OWL reasoning, so the
# chain is spelled out: the next checkpoint comes after, and so on.
rule next_is_after:
  match:
    ?a next ?b
  then:
    ?b after ?a

rule passed_after:
  match:
    ?a after ?b
    ?b after ?c
  then:
    ?a after ?c

# Runners: bib 101-120 finish, 121-126 stop at an aid station, 127-128 are
# timed out at a cutoff, 129-130 did not start.

fact r101 a Runner
  bib 101
  first_name "Kilian"
  category SEN_H
  birthdate date(March 12th 1994)
  gear HEADLAMP, SURVIVAL_BLANKET, WATER_1L
